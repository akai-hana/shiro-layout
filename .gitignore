.*
!.gitignore

# Python caches
__pycache__/
*.py[cod]

# Downloaded corpus archives
*.xz
*.zip

# Extracted raw corpus sources
corpora/*/resources/*.txt
corpora/*/resources/*/

# Temporary corpus working directories
corpora/*/tmp/
corpora/*/.tmp/
# Local generated outputs; curated layouts under layouts/<name>/ are tracked.
/layouts/layout_*.txt
/layouts/latest
/layouts/generate_*
/layouts/analysis*
/layouts/audit_*
/layouts/compute_*
/layouts/preference_sweep_*
/layouts/archive/
/layouts/calibration/
/layouts/fitting/
/layouts/repeat-aware/
/layouts/round8/
/layouts/rust/
/layouts/validation/

# Rust build artifacts
/target
